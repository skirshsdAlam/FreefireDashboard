<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#1a1a2e">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#e94560"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔥 Free Fire Dashboard 🔥"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#fff"
            android:gravity="center" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Player ID: 1234567890"
            android:textSize="12sp"
            android:textColor="#ddd"
            android:gravity="center"
            android:layout_marginTop="10dp" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="15dp"
        android:gravity="center">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/stat_card_bg"
            android:padding="10dp"
            android:layout_margin="5dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Level"
                android:textSize="12sp"
                android:textColor="#ff6b35"
                android:gravity="center" />

            <TextView
                android:id="@+id/tvPlayerLevel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="45"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#fff"
                android:gravity="center" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/stat_card_bg"
            android:padding="10dp"
            android:layout_margin="5dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Kills"
                android:textSize="12sp"
                android:textColor="#ff6b35"
                android:gravity="center" />

            <TextView
                android:id="@+id/tvTotalKills"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="1,250"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#fff"
                android:gravity="center" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/stat_card_bg"
            android:padding="10dp"
            android:layout_margin="5dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Wins"
                android:textSize="12sp"
                android:textColor="#ff6b35"
                android:gravity="center" />

            <TextView
                android:id="@+id/tvTotalWins"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="380"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#fff"
                android:gravity="center" />

        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="10dp">

        <Button
            android:id="@+id/btnWeapons"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:text="🔫 Weapons"
            android:textColor="#fff"
            android:background="#e94560"
            android:layout_margin="5dp" />

        <Button
            android:id="@+id/btnMap"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:text="🗺️ Map"
            android:textColor="#fff"
            android:background="#e94560"
            android:layout_margin="5dp" />

        <Button
            android:id="@+id/btnLeaderboard"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:text="🏅 Top"
            android:textColor="#fff"
            android:background="#e94560"
            android:layout_margin="5dp" />

    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="👥 Players"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#ff6b35"
        android:padding="15dp" />

    <GridView
        android:id="@+id/playerGridView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:numColumns="2"
        android:padding="10dp"
        android:horizontalSpacing="10dp"
        android:verticalSpacing="10dp" />

</LinearLayout>